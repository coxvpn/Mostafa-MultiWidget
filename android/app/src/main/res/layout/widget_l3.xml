<?xml version="1.0" ?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:layoutDirection="ltr" android:orientation="vertical" android:padding="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2.4" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:id="@+id/weather_box" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05" android:background="@drawable/tile_sky" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/sun" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:id="@+id/weather" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="44sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/minmax" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:id="@+id/temp_high" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="#FF8A80" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:id="@+id/temp_low" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="#82C4FF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/city_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="#E6FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:id="@+id/aqi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:visibility="gone" android:paddingStart="6dp" android:paddingEnd="6dp"/>
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="6dp" android:layout_height="match_parent"/>
<LinearLayout android:id="@+id/info" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/tile_glass" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
<TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
<TextView android:id="@+id/date2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
<LinearLayout android:id="@+id/prayer_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.1" android:layout_marginTop="2dp" android:background="@drawable/chip_glass" android:orientation="horizontal" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
<Chronometer android:id="@+id/prayer_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_prayer" android:textSize="14sp" android:textStyle="bold"/>
<TextView android:id="@+id/prayer_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:layout_marginStart="6dp"/>
</LinearLayout>
<TextView android:id="@+id/occasion" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="0.7" android:layout_gravity="end" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:paddingStart="8dp" android:paddingEnd="8dp" android:visibility="gone"/>
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="6dp"/>
<TextClock android:id="@+id/clock" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="56sp" android:autoSizeStepGranularity="1sp" android:visibility="gone"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@color/widget_btn" android:id="@+id/divider_a"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.95" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:id="@+id/cell_rate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.45" android:background="@drawable/tile_rate_flat" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
<TextView android:id="@+id/rate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
<TextView android:id="@+id/lbl_rate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
<FrameLayout android:layout_width="6dp" android:layout_height="match_parent"/>
<LinearLayout android:id="@+id/usage_box" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_wifi" android:contentDescription="@null" android:id="@+id/icon_wifi"/>
<TextView android:id="@+id/wifi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:layout_marginStart="3dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_signal" android:contentDescription="@null" android:id="@+id/icon_sim"/>
<TextView android:id="@+id/sim" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:layout_marginStart="3dp"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:orientation="horizontal" android:gravity="center_vertical|end">
<TextView android:id="@+id/country" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
<TextView android:id="@+id/flag" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
<TextView android:id="@+id/refresh" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="4dp" android:layout_gravity="center_vertical" android:background="@drawable/btn_bg" android:contentDescription="@string/refresh" android:gravity="center" android:text="↻" android:textColor="@color/widget_text" android:textSize="14sp"/>
</LinearLayout>
</LinearLayout>